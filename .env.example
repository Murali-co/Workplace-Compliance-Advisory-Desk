# Copy to an untracked .env; fill the Neon connection and unique client tokens.
APP_ENV=development
DATABASE_URL=
# Opt in only when hostname-only Cloudflare DNS requests are authorized.
# system uses ordinary asyncpg/system DNS; cloudflare uses verified TLS + libpq hostaddr.
DATABASE_DNS_RESOLVER=system
# JSON mapping of stable client names to long random secrets; never commit real values.
AUTH_CLIENT_TOKENS={}
# Optional localhost Vite demo: open the workspace without typing its access key.
LOCAL_DEMO_ENABLED=false
LOCAL_DEMO_CLIENT_ID=local-demo
COMPLIANCE_API_URL=http://127.0.0.1:8010
API_PORT=8010
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# For commands run on the host (Compose overrides these for its internal network).
REDIS_URL=redis://127.0.0.1:6380/0
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8002
CHROMA_COLLECTION=workplace_compliance_provisions_v1
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
# Use lexical for fast local retrieval without downloading embedding weights.
RETRIEVAL_MODE=lexical
QUEUE_WAIT_TIMEOUT_SECONDS=20
RUN_TIMEOUT_SECONDS=45
RESPONSE_DEADLINE_SECONDS=60
# Providers: stub (simulator), ollama (local), hosted (separate API billing).
LLM_PROVIDER=stub
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL_NAME=
# For local Ollama, set LLM_PROVIDER=ollama and LLM_MODEL_NAME to an installed model.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_SECONDS=30
# Enable reasoning for installed Qwen3 models.
OLLAMA_THINK=false
OLLAMA_CONTEXT_TOKENS=16384
LOCAL_WORKER_CONCURRENCY=1
STUB_SERVICE_URL=http://127.0.0.1:8001
STUB_DELAY_SECONDS=2
# Destructive acceptance tests require an explicitly isolated Neon test branch.
TEST_DATABASE_URL=
TEST_CHROMA_COLLECTION=
